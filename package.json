{
  "name": "duantaovideo",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React Google Flow workflow studio, using gflow-cli and google-flow-cli",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist": "npm run build && electron-builder",
    "test": "node --test tests/*.test.cjs",
    "postinstall": "node scripts/patch-gflow.cjs"
  },
  "dependencies": {
    "@swissmarley/gflow-cli": "1.1.1",
    "google-flow-cli": "github:Zahed316/google-flow-cli#070bc1a74b16b36c33ee480d4d7b544e364d9329",
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "vn.duantaovideo.studio",
    "productName": "DuAnTaoVideo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@swissmarley/gflow-cli/**/*",
      "node_modules/google-flow-cli/**/*",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
